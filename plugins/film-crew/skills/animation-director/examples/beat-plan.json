    "percussion": false,
    "seed": 31
  },
  "narration": [
    {
      "id": "l1",
      "audio": "vo/l1.wav",
      "gap_after": 0.65,
      "text": "Every winter, the village of Kestrel put one lantern on the hill."
    },
    {
      "id": "l2",
      "audio": "vo/l2.wav",
      "gap_after": 0.75,
      "text": "Not for the living. For whoever was still walking home."
    },
    {
      "id": "l3",
      "audio": "vo/l3.wav",
      "gap_after": 0.55,
      "text": "Old Mira had carried it up for forty-one years."
    },
    {
      "id": "l4",
      "audio": "vo/l4.wav",
      "gap_after": 0.7,
      "text": "Forty-one winters. The same seven hundred steps."
    },
    {
      "id": "l5",
      "audio": "vo/l5.wav",
      "gap_after": 0.6,
      "text": "The rule was simple. Light it before dark, and never look back down."
    },
    {
      "id": "l6",
      "audio": "vo/l6.wav",
      "gap_after": 0.8,
      "text": "Nobody living remembered who made the rule."
    },
    {
      "id": "l7",
      "audio": "vo/l7.wav",
      "gap_after": 0.55,
      "text": "The winter Mira turned eighty, the snow came early."
    },
    {
      "id": "l8",
      "audio": "vo/l8.wav",
      "gap_after": 0.65,
      "text": "It buried the path by noon, and the markers by three."
    },
    {
      "id": "l9",
      "audio": "vo/l9.wav",
      "gap_after": 0.6,
      "text": "She went up anyway, with the lantern held under her coat."
    },
    {
      "id": "l10",
      "audio": "vo/l10.wav",
      "gap_after": 0.5,
      "text": "Halfway, the wind found the flame and took it."
    },
    {
      "id": "l11",
      "audio": "vo/l11.wav",
      "gap_after": 0.7,
      "text": "And in the dark, she heard the thing the rule was for."
    },
    {
      "id": "l12",
      "audio": "vo/l12.wav",
      "gap_after": 0.85,
      "text": "Footsteps. Below her. Climbing."
    },
    {
      "id": "l13",
      "audio": "vo/l13.wav",
      "gap_after": 0.6,
      "text": "Mira did not look back. She had promised, sixty years ago."
    },
    {
      "id": "l14",
      "audio": "vo/l14.wav",
      "gap_after": 0.45,
      "text": "She struck a match. The wind ate it."
    },
    {
      "id": "l15",
      "audio": "vo/l15.wav",
      "gap_after": 0.55,
      "text": "She struck another, and another, until her hands would not close."
    },
    {
      "id": "l16",
      "audio": "vo/l16.wav",
      "gap_after": 0.7,
      "text": "The footsteps stopped, one step behind her."
    },
    {
      "id": "l17",
      "audio": "vo/l17.wav",
      "gap_after": 0.9,
      "text": "And a voice she had not heard since she was a girl said her name."
    },
    {
      "id": "l18",
      "audio": "vo/l18.wav",
      "gap_after": 0.95,
      "text": "Mira turned around."
    },
    {
      "id": "l19",
      "audio": "vo/l19.wav",
      "gap_after": 0.6,
      "text": "There was nobody on the stairs. Only snow, and her own tracks, going up."
    },
    {
      "id": "l20",
      "audio": "vo/l20.wav",
      "gap_after": 0.85,
      "text": "And the lantern in her hands was burning."
    },
    {
      "id": "l21",
      "audio": "vo/l21.wav",
      "gap_after": 0.7,
      "text": "She never learned who lit it."
    },
    {
      "id": "l22",
      "audio": "vo/l22.wav",
      "gap_after": 0.65,
      "text": "But she carried it to the top, and set it down, and walked home."
    },
    {
      "id": "l23",
      "audio": "vo/l23.wav",
      "gap_after": 0.6,
      "text": "In Kestrel they still put a lantern on the hill each winter."
    },
    {
      "id": "l24",
      "audio": "vo/l24.wav",
      "gap_after": 0.4,
      "text": "They still tell you not to look back. They no longer tell you why."
    }
  ],
