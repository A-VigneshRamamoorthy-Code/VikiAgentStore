{
  "schema": 1,
  "title": "The Last Lantern on Kestrel Hill",
  "seed": 31,
  "timing": {
    "lead_in": 1.6,
    "tail": 3.2
  },
  "music": {
    "mood": "music_box",
    "scale": "minor",
