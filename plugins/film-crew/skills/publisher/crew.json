{
  "crew_api": 1,
  "id": "publisher",
  "role": "Publisher",
  "about": "Gets the finished film onto the platform and no further: uploads private, verifies what actually went live, and refuses to release anything the director did not approve.",
  "provides_lib": {
    "config": "scripts/config.py"
  },
  "provides": [
    {
      "stage": "publish",
      "order": 100,
      "scope": "deliverable",
      "emits": [
        "meta/upload_result.json"
      ],
      "needs": {
        "episode": [
          "clearance"
        ],
        "short": [
          "clearance"
        ]
      },
      "when": {
        "brief": {
          "channel": "truthy",
          "publish": "truthy"
        }
      },
      "irreversible": {
        "covers": [
          "render",
          "shoot",
          "mix",
          "captions",
          "package"
        ]
      },
      "briefing": "Upload private, verify what actually went live, then publish."
    }
  ]
}
