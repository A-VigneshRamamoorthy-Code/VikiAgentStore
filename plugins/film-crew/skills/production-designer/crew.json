{
  "crew_api": 1,
  "id": "production-designer",
  "role": "Production designer",
  "about": "Owns the look: picks a style skill, compiles the beat plan into it and renders.",
  "provides": [
    {
      "stage": "compile",
      "order": 70,
      "scope": "episode",
      "emits": [
        "storyboard.json"
      ],
      "needs": [
        "board"
      ],
      "uses_style": true,
      "briefing": "Compile the beat plan into this style's own storyboard, then review the contact sheet before rendering."
    },
    {
      "stage": "render",
      "order": 75,
      "scope": "episode",
      "emits": [
        "*.mp4"
      ],
      "needs": [
        "compile"
      ],
      "uses_style": true,
      "briefing": "Render the episode and verify format, loudness and motion."
    },
    {
      "stage": "shoot",
      "order": 85,
      "scope": "short",
      "emits": [
        "*.mp4"
      ],
      "needs": [
        "cut"
      ],
      "uses_style": true,
      "when": {
        "brief": {
          "shorts": "truthy"
        }
      },
      "briefing": "Render the vertical Short and verify it stands alone without the episode around it."
    }
  ],
  "provides_styles": {
    "registry": "scripts/registry.py"
  }
}
