{
  "schema": 1,
  "title": "Pursuit",
  "seed": 19,
  "timing": {
    "lead_in": 1.2,
    "tail": 1.8
  },
  "narration": [
    {
      "id": "l1",
      "text": "Sky Nine is live above the eastbound ring road, where police are pursuing a suspect vehicle.",
      "audio": "vo/l1.wav",
      "gap_after": 0.5
    },
    {
      "id": "l2",
      "text": "We're told the driver has refused to stop for officers.",
      "audio": "vo/l2.wav",
      "gap_after": 0.5
    },
    {
      "id": "l3",
      "text": "And there it is. The suspect vehicle.",
      "audio": "vo/l3.wav",
      "gap_after": 1.2
    },
    {
      "id": "l4",
      "text": "Travelling at speeds approaching twenty-two miles per hour.",
      "audio": "vo/l4.wav",
      "gap_after": 1.1
    },
    {
      "id": "l5",
      "text": "The driver is showing no signs of panic whatsoever.",
      "audio": "vo/l5.wav",
      "gap_after": 1.0
    },
    {
      "id": "l6",
      "text": "He has indicated. Correctly. At every junction so far.",
      "audio": "vo/l6.wav",
      "gap_after": 1.2
    },
    {
      "id": "l7",
      "text": "Police have now committed six vehicles to the operation.",
      "audio": "vo/l7.wav",
      "gap_after": 0.6
    },
    {
      "id": "l8",
      "text": "Wait. Wait, he's making his move!",
      "audio": "vo/l8.wav",
      "gap_after": 0.35
    },
    {
      "id": "l9",
      "text": "He has stopped. A tense standoff at the junction of Wexley Road.",
      "audio": "vo/l9.wav",
      "gap_after": 1.3
    },
    {
      "id": "l10",
      "text": "Nobody is moving. Nobody dares.",
      "audio": "vo/l10.wav",
      "gap_after": 1.2
    },
    {
      "id": "l11",
      "text": "The lights have changed.",
      "audio": "vo/l11.wav",
      "gap_after": 0.7
    },
    {
      "id": "l12",
      "text": "He is indicating left. He is parking.",
      "audio": "vo/l12.wav",
      "gap_after": 1.2
    },
    {
      "id": "l13",
      "text": "The suspect has exited the vehicle. He is carrying what appears to be a sandwich.",
      "audio": "vo/l13.wav",
      "gap_after": 1.1
    },
    {
      "id": "l14",
      "text": "He is waving. At us.",
      "audio": "vo/l14.wav",
      "gap_after": 1.4
    },
    {
      "id": "l15",
      "text": "We may have been covering a man's drive home.",
      "audio": "vo/l15.wav",
      "gap_after": 1.5
    },
    {
      "id": "l16",
      "text": "Sky Nine. Back to the studio.",
      "audio": "vo/l16.wav",
      "gap_after": 1.6
    }
  ],
