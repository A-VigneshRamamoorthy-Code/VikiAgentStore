{
  "style_api": 1,
  "id": "2d-animation",
  "name": "2D Character Animation",
  "version": "1.0.0",
  "aliases": [
    "2d",
    "cartoon",
    "toon",
    "character",
    "character-animation",
    "animation",
    "comedy",
    "chase",
    "motion-comic"
  ],
  "tagline": "Rigged characters that perform, staged in soft desaturated air: locked-off compositions, long holds, and one figure carrying all the colour.",
  "doc": "SKILL.md",
  "strengths": [
    "comedy",
    "explainer",
    "business",
    "science",
    "gaming",
    "fiction",
    "advert",
    "character"
  ],
  "avoid": [
    "live-action",
    "screen-recording",
    "text-heavy",
    "journalism",
    "investigation",
    "disaster"
  ],
  "aspects": [
    "16:9",
    "9:16"
  ],
  "deliverables": [
    "episode",
    "short"
  ],
  "narration": "optional",
  "cuts": true,
  "deterministic": true,
  "beat_plan": 1,
  "motion_plan": 1,
  "storyboard_schema": "reference/storyboard-reference.md",
  "entrypoints": {
    "compile": [
      "python3",
      "{style}/scripts/compile.py",
      "{beat_plan}",
      "-o",
      "{storyboard}"
    ],
    "compile_directed": [
      "python3",
      "{style}/scripts/compile.py",
      "{beat_plan}",
      "-o",
      "{storyboard}",
      "--motion-plan",
      "{motion_plan}"
    ],
    "check": [
      "python3",
      "{style}/scripts/compile.py",
      "{beat_plan}",
      "--check"
    ],
    "preview": [
      "python3",
      "{style}/scripts/render.py",
      "{storyboard}",
      "--sheet"
    ],
    "render": [
      "python3",
      "{style}/scripts/render.py",
      "{storyboard}",
      "-j",
      "0"
    ]
  },
  "_renderers": "Alternative picture pipelines this style has a working path for. Opt-in, not assumed: a renderer that is not this style's own has to be able to draw it, which is work someone has to have done.",
  "renderers": [
    "remotion",
    "unreal"
  ],
  "requires": {
    "bin": [
      "ffmpeg",
      "ffprobe"
    ],
    "python": [
      "PIL",
      "numpy"
    ]
  },
  "verify": {
    "width": 1920,
    "height": 1080,
    "fps": 30,
    "loudness_lufs": -14.0,
    "true_peak_dbfs": -1.0,
    "motion_mean_min": 1.2,
    "motion_mean_target": 2.4,
    "longest_hold_s_max": 2.5,
    "look": {
      "_": "Measured off the two reference films at lookcheck.py's own sampling rate, not chosen. `scripts/lookcheck.py` grades a finished film against these; a film outside them does not look like the reference, whatever else it gets right. Reference readings, summit / getaway: saturation 0.070 / 0.129, hot area 0.025 / 0.003, value 0.723 / 0.868, cuts 5.2 / 0.0, frame-diff 0.0043 / 0.0035.",
      "saturation_mean": [
        0.05,
        0.15
      ],
      "saturation_hot_area_max": 0.045,
      "value_mean": [
        0.66,
        0.9
      ],
      "cuts_per_min_max": 7.0,
      "frame_diff_median": [
        0.0015,
        0.012
      ]
    }
  }
}